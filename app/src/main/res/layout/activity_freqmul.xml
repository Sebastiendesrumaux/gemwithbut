<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#121212">
    <TextView android:id="@+id/text_root_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="10sp" android:paddingBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/button_root_rep" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="SET FOLDER" android:textSize="10sp" />
        <Button android:id="@+id/button_list_mp3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="UPDATE LIST" android:textSize="10sp" />
    </LinearLayout>
    <ListView android:id="@+id/list_mp3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:divider="#333333" android:dividerHeight="1dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Random frequency range :" android:textColor="#FFFFFF" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min: " android:textColor="#FFFFFF" />
        <EditText android:id="@+id/edit_mul_min" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberDecimal" android:textColor="#4CAF50" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Max: " android:textColor="#FFFFFF" />
        <EditText android:id="@+id/edit_mul_max" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberDecimal" android:textColor="#4CAF50" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/button_reset_freq" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="ZEN RESET (1/2 TONE)" android:backgroundTint="#455A64" android:textSize="10sp" />
        <Button android:id="@+id/button_440" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="BACK TO 440HZ" android:backgroundTint="#607D8B" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/button_play_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ALL" android:layout_margin="1dp" android:backgroundTint="#1976D2" android:textSize="10sp" />
        <Button android:id="@+id/button_play_random" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RAND" android:layout_margin="1dp" android:backgroundTint="#2E7D32" android:textSize="10sp" />
        <Button android:id="@+id/button_next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="NEXT" android:layout_margin="1dp" android:backgroundTint="#EF6C00" android:textSize="10sp" />
        <Button android:id="@+id/button_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="STOP" android:layout_margin="1dp" android:backgroundTint="#C62828" android:textSize="10sp" />
    </LinearLayout>
    <ListView android:id="@+id/list_log" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:layout_marginTop="8dp" android:background="#000000" android:divider="#111111" android:dividerHeight="1dp" />
</LinearLayout>
