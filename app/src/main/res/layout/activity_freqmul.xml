<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/text_root_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="(root path)" android:textSize="12sp" />
        <Button android:id="@+id/button_root_rep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dossier" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <Button android:id="@+id/button_list_mp3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lister" />
        <Button android:id="@+id/button_play_random" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Random" />
        <Button android:id="@+id/button_stop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Stop" />
    </LinearLayout>

    <ListView android:id="@+id/list_mp3" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min:" android:textSize="12sp" />
        <EditText android:id="@+id/edit_mul_min" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberDecimal" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Max:" android:textSize="12sp" />
        <EditText android:id="@+id/edit_mul_max" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberDecimal" android:textSize="12sp" />
    </LinearLayout>

    <Button android:id="@+id/button_reset_freq" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="reset fréq mul" 
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:backgroundTint="#607D8B" />

    <Button android:id="@+id/button_toggle_speech" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speech: OFF" android:layout_marginTop="4dp" />

    <FrameLayout android:id="@+id/cam_container" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp" />

    <ScrollView
        android:id="@+id/scroll_transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/text_transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
