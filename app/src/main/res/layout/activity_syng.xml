<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Choix du répertoire racine -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_root_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="(root path)"
            android:textSize="12sp"
            android:maxLines="2" />

        <Button
            android:id="@+id/button_root_rep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dossier" />
    </LinearLayout>

    <!-- Liste MP3 + commandes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/button_list_mp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lister" />

        <Button
            android:id="@+id/button_play_random"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Random" />

        <Button
            android:id="@+id/button_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Stop" />
    </LinearLayout>

    <ListView
        android:id="@+id/list_mp3"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="8dp" />

    <!-- Caméra -->
    <FrameLayout
        android:id="@+id/cam_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="10dp" />

    <!-- Config caméra -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Spinner
            android:id="@+id/spinner_resolution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinner_fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkbox_stab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Stabilisation" />

    <!-- Commandes enregistrement -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/button_record"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REC" />

        <Button
            android:id="@+id/button_stop_rec"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="STOP" />
    </LinearLayout>

    <!-- Journal / transcription (SCROLLABLE) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Console"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scroll_transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/text_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:padding="8dp"
            android:text="" />
    </ScrollView>

</LinearLayout>
